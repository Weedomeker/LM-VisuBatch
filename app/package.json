{
  "name": "LM-VisuBatch",
  "version": "0.4.0",
  "productName": "LM VisuBatch",
  "private": true,
  "description": "Génération par lot des visuels web des panneaux de douche",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "generate": "node src/cli/generate.js",
    "inventaire": "node src/cli/inventaire.js",
    "test": "node --test test/clientConfig.test.js test/inventaire.test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "sharp": "^0.35.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "author": "Deco-K-IN",
  "build": {
    "appId": "fr.decokin.LM-VisuBatch",
    "asar": false,
    "files": [
      "package.json",
      "src/**",
      "resources/**"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "LM-VisuBatch-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "LM VisuBatch"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
